# Copia este archivo a .env (no lo subas al repositorio) y ajusta los valores.
# Ningún valor de este archivo es un secreto real.

# Entorno: "development" (por defecto) o "production".
NODE_ENV=development

# Puerto HTTP y dirección de escucha.
PORT=5000
HOST=127.0.0.1

# Ruta del archivo SQLite. Debe estar fuera del código fuente en producción.
DATABASE_PATH=data/riaggio.db

# Duración de la sesión y de las invitaciones, en horas.
SESSION_TTL_HOURS=8
INVITATION_TTL_HOURS=72

# Solo para `npm run seed:demo`: contraseña de las cuentas de demostración.
# Si se omite, se genera una aleatoria y se muestra una vez.
# RIAGGIO_DEMO_PASSWORD=cambia-esta-contraseña-de-demo
# En producción, el seed de demostración está bloqueado salvo ALLOW_DEMO_SEED=1.
