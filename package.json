{
  "name": "riaggio-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "seed:demo": "tsx server/cli.ts seed-demo",
    "bootstrap-admin": "tsx server/cli.ts bootstrap-admin"
  },
  "dependencies": {
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
